# NVIDIA NIM API Key (usada pelo OpenCode para o provider nvidia)
NVIDIA_API_KEY=

# URL base do site publicado no GitHub Pages
SITE_BASE_URL=https://zecabigodinho.github.io/curso-python/

# Modelo do OpenCode para geração de conteúdo
OPENCODE_MODEL=nvidia/deepseek-ai/deepseek-v4-pro

# Timeout em segundos para a chamada ao OpenCode
OPENCODE_TIMEOUT=600

# ── Hermes VPS (para o watcher consultar) ──────────────────────────
# URL base da API Hermes (acessível via Tailscale)
HERMES_API_URL=http://100.x.x.x:8765

# Token de autenticação para a API Hermes
HERMES_API_TOKEN=

# ── Tailscale (para o Hermes checar disponibilidade do PC) ─────────
# IP Tailscale do PC Windows
PC_TAILSCALE_IP=100.x.x.x

# ── Watcher ────────────────────────────────────────────────────────
# Intervalo de polling em segundos
WATCHER_POLL_INTERVAL=60

# ── Telegram (para o Hermes) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SSH (opcional — para disparo remoto via Hermes) ────────────────
# Usuário SSH no PC Windows
SSH_USER=
# Caminho da chave privada SSH (na VPS)
SSH_KEY_PATH=
